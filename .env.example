# Copy this file to .env.local and fill it in. Never commit .env.local.

# Public address of the site, without a trailing slash
APP_URL=http://localhost:3000

# Neon: the pooled string (host contains "-pooler") is used by the app,
# the direct string is used only for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Local database tools: copy these independently from the Neon dashboard
# with quizo-room-scoring-dev selected. Use the full direct hostname (no
# scheme or port) and the exact database name. Run npm run db:verify:dev.
DEV_NEON_DIRECT_HOST=
DEV_NEON_DATABASE=

# At least 32 random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Signs guest codes and public tournament handles. Generate the same way.
HMAC_SECRET=

# Email: the SMTP account that sends confirmation and reset emails (same one the PHP site uses).
# While these are empty, emails are printed in the terminal running "npm run dev" instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QuizoTab <quizotab01@gmail.com>"

# What one tournament costs in each format, shown on the policy pages and charged at checkout.
# While TOURNAMENT_PRICES is empty the policy pages say "Shown before you pay".
TOURNAMENT_CURRENCY=TZS
TOURNAMENT_PRICES=
# Example: TOURNAMENT_PRICES={"quiz-night":50000,"league":0,"knockout":0,"championship":0}

# Live quizzes: the "something changed" signal sent to every screen in a game, through Supabase Realtime
# (the same project the PHP site uses). Optional: without these, screens check for changes every few seconds.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Host names that question pictures and videos may be loaded from, comma-separated (set once uploads are on)
MEDIA_HOSTS=

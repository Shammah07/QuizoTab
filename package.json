    "pilot:host:v1:verify": "tsx scripts/pilot.mts host-verify",
    "pilot:host:v1:close": "tsx scripts/pilot.mts host-close",
    "pilot:host:v1:verify-closed": "tsx scripts/pilot.mts host-verify-closed",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
